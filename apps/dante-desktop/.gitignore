/target
/gen
/Cargo.lock
# `cargo tauri icon icons/icon.png` regenerates the whole platform set from the
# source below. Only the source is tracked — without it `generate_context!`
# has no icon to embed and the crate will not compile.
/icons/*.png
!/icons/icon.png
/icons/*.ico
# tauri-build requires this one on Windows to emit the resource file — without
# it the crate does not compile there at all, so it is a source, not an output.
!/icons/icon.ico
/icons/*.icns
